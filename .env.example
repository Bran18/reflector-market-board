# Copy this file to `.env.local` and fill in values.
# Next.js reads `.env.local` on the server. These are not NEXT_PUBLIC_*
# because Pulse reads happen in Server Components, not the browser.

# Any Stellar account public key (G...).
# @reflector/contract-client always takes a publicKey so it can build a
# simulation transaction sourced from that account. Read-only Pulse
# methods simulate on RPC and never sign or submit, so this key does not
# need to be yours, funded, or paired with a secret.
REFLECTOR_PUBLIC_KEY=

# Soroban JSON-RPC endpoint. PulseClient uses it to simulate contract
# invocations (assets, lastPrice, decimals, …). Horizon cannot substitute.
# Example (public): https://rpc.lightsail.network/
REFLECTOR_RPC_URL=

# Pulse oracle contract to query. Several Pulse instances exist; you must
# pick one. Default for this demo is Stellar Pubnet Pulse (on-chain Stellar
# DEX / pool prices, typically quoted in USDC):
#   CALI2BYU2JE6WVRUFYTS6MSBNEHGJ35P4AVCZYF3B6QOE3QKOB2PLE6M
# External CEX & DEX Pulse (Other tickers such as BTC, quoted in USD):
#   CAFJZQWSED6YAWZU3GWRTOCNPPCGBN32L7QV43XX5LZLFTK6JLN34DLN
# Fiat FX Pulse:
#   CBKGPWGKSKZF52CFHMTRR23TBWTPMRDIYZ4O2P5VS65BMHYH4DXMCJZC
REFLECTOR_PULSE_CONTRACT_ID=CALI2BYU2JE6WVRUFYTS6MSBNEHGJ35P4AVCZYF3B6QOE3QKOB2PLE6M

# Optional. Defaults to Stellar Public Network.
# Testnet: Test SDF Network ; September 2015
# REFLECTOR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
